              style: HackerTheme.captionText().copyWith(
                color: HackerTheme.accentGreen,
                fontSize: 10,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildRepositoryCard(GitHubRepository repo) {
