# Involvex App - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Discord OAuth
# Get these from: https://discord.com/developers/applications
# Set redirect URI to: involvex://discord-oauth-redirect (for mobile) or your web callback URL
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_OAUTH_CALLBACK=involvex://discord-oauth-redirect

# GitHub OAuth
# Get these from: https://github.com/settings/developers
# Set callback URL to: https://yourdomain.com/github-oauth-callback (web) or involvex://github-oauth-redirect (mobile)
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_CALLBACK=involvex://github-oauth-redirect

# API Keys (optional - for enhanced trending data)
# GITHUB_TOKEN=your_github_personal_access_token
# NPM_TOKEN=your_npm_token